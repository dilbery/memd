#!/usr/bin/env python3
"""memd-mcp-bridge: stdio <-> HTTP MCP bridge for Claude Desktop.

Claude Desktop can only launch stdio MCP servers, but memd serves MCP over
streamable HTTP at <server>/mcp/ behind a Bearer token. This bridge lets
Claude Desktop act as a plain stdio client while forwarding every JSON-RPC
message over HTTP and returning the reply.

Pure standard library on purpose — no npm, no memd install needed — so it can
be dropped into any claude_desktop_config.json as a stdio command.

Notification handling: a JSON-RPC message with NO "id" field is a
notification. The memd server replies HTTP 202 with an empty body for those,
and this bridge writes NOTHING back to stdout, because emitting a reply to a
notification would corrupt the MCP protocol stream. stdout is the protocol
channel and must never carry anything that is not a real JSON-RPC message.
"""
import json
import os
import shlex
import sys
import time
import urllib.error
import urllib.request

DEFAULT_ENDPOINT = "https://memd.example.com"
DEFAULT_ENV_FILE = os.path.expanduser("~/.config/memd/client.env")
# Total attempts for read operations that get no reply (see post_raw).
NETWORK_ATTEMPTS = 3
RETRY_BACKOFF = 0.25


def resolve_endpoint(argv):
    # Skip flags so `--selftest` is not mistaken for the server URL.
    positional = [a for a in argv[1:] if not a.startswith("-")]
    base = positional[0] if positional else os.environ.get("MEMD_REMOTE")
    if not base:
        base = DEFAULT_ENDPOINT
    return base.rstrip("/") + "/mcp/"


def token_from_env_file():
    """Read MEMD_TOKEN from the secrets-manager env file materialised in tmpfs.

    An agent CLI launches this bridge with a static env block from its JSON/TOML
    config, which cannot carry a secret without writing it to disk in plaintext.
    So the token is not in the environment: read it from `$MEMD_ENV_FILE`
    (per-consumer, e.g. memd-codex.env) instead. A missing file yields no token,
    exactly as before, so the bridge still runs standalone.
    """
    path = os.environ.get("MEMD_ENV_FILE") or DEFAULT_ENV_FILE
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                key, sep, val = line.removeprefix("export ").partition("=")
                if sep and key.strip() == "MEMD_TOKEN":
                    values = shlex.split(val, comments=True)
                    return values[0] if len(values) == 1 else None
    except (OSError, ValueError):
        return None
    return None


def resolve_token():
    """Resolve the bearer token, returning (token, source) for diagnostics.

    An explicitly configured `MEMD_ENV_FILE` WINS over an inherited `MEMD_TOKEN`.
    That order matters: the file is materialised by the secrets manager and is always
    current, whereas an inherited env var is a *snapshot* taken when the parent
    shell started. A long-lived tmux session that began before a token
    rotation keeps serving the pre-rotation value to every child forever, and
    env-first precedence let that dead snapshot silently beat the live secret —
    the server's only reply is `401 {"error":"invalid or missing token"}`, with
    nothing to say which of the two sources was used. That cost about an hour
    of debugging once.

    With no `MEMD_ENV_FILE` set, keep env-first so an operator can still override
    the default file by exporting a token by hand.
    """
    explicit = os.environ.get("MEMD_ENV_FILE")
    env_token = os.environ.get("MEMD_TOKEN")
    file_token = token_from_env_file()

    if explicit and file_token:
        return file_token, "env file {}".format(explicit)
    if env_token:
        return env_token, "$MEMD_TOKEN"
    if file_token:
        return file_token, "env file {}".format(explicit or DEFAULT_ENV_FILE)
    return None, "no token found"


def resolve_timeout():
    raw = os.environ.get("MEMD_BRIDGE_TIMEOUT")
    try:
        return float(raw) if raw is not None else 30.0
    except ValueError:
        return 30.0


def response_message(body, expected_id):
    """Decode a JSON or SSE response, requiring a matching JSON-RPC envelope."""
    text = body.decode("utf-8")
    try:
        messages = [json.loads(text)]
    except ValueError:
        messages = []
        for event in text.replace("\r\n", "\n").split("\n\n"):
            data = "\n".join(line[5:].lstrip() for line in event.splitlines()
                             if line.startswith("data:"))
            if data:
                messages.append(json.loads(data))
    for msg in messages:
        if (isinstance(msg, dict) and msg.get("jsonrpc") == "2.0"
                and msg.get("id") == expected_id
                and (("result" in msg) != ("error" in msg))):
            return msg
    raise ValueError("missing matching JSON-RPC response")


def selftest(endpoint, token, source):
    """Prove the token WORKS, not merely that one was found.

    The old selftest printed "yes" whenever a token was present, so a revoked or
    stale token reported healthy and the only way to discover otherwise was to
    watch an agent's tool call fail with an opaque 401. It now names the source it
    resolved and does a real `tools/list` round trip, so `--selftest` answers "is
    memd actually usable right now" in one command. Exit code is non-zero on
    failure so a health check or hook can branch on it.
    """
    print(endpoint)
    print("yes" if token else "no")
    print("source: {}".format(source))
    if not token:
        return 1
    probe = json.dumps({"jsonrpc": "2.0", "id": "selftest", "method": "tools/list"})
    status, body = post_raw(endpoint, probe, token, 10.0)
    detail = body.decode("utf-8", errors="replace").strip()[:160]
    if status == 200:
        try:
            message = response_message(body, "selftest")
            if "error" in message:
                raise ValueError("JSON-RPC error")
            names = [t["name"] for t in message["result"]["tools"]]
            if not {"recall", "save"}.issubset(names):
                raise ValueError("missing recall/save tools")
        except (KeyError, TypeError, ValueError, UnicodeError) as exc:
            print("probe: HTTP 200 invalid discovery: {}".format(exc))
            return 1
        print("probe: HTTP 200 OK tools=" + ",".join(names))
        return 0
    print("probe: HTTP {} {}".format(status if status != -1 else "network error", detail))
    return 1


def synthesize_error(msg_id, reason):
    return json.dumps({
        "jsonrpc": "2.0",
        "id": msg_id,
        "error": {"code": -32603, "message": reason},
    })


def post_once(endpoint, raw_line, token, timeout):
    """One HTTP round trip. Returns (status, body); status -1 means no reply."""
    headers = {
        "Content-Type": "application/json",
        "Accept": "application/json, text/event-stream",
    }
    if token:
        headers["Authorization"] = "Bearer " + token
    req = urllib.request.Request(
        endpoint, data=raw_line.encode("utf-8"), headers=headers, method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read()
            return resp.status, body
    except urllib.error.HTTPError as exc:
        # Keep the error body: it is the only diagnostic the client will ever get,
        # and discarding it made every HTTP failure indistinguishable from a
        # notification — see handle_line.
        try:
            return exc.code, exc.read()
        except Exception:
            return exc.code, b""
    except Exception:
        return -1, b""


def post_raw(endpoint, raw_line, token, timeout, attempts=NETWORK_ATTEMPTS):
    """Retry read requests on network failure; never replay an ambiguous write."""
    # A lost reply does not mean the server did not commit a write. Retry only
    # known read operations; unknown/future tools are conservatively one-shot.
    try:
        request = json.loads(raw_line)
        safe = request.get("method") in {"tools/list", "ping", "initialize"} or (
            request.get("method") == "tools/call"
            and request.get("params", {}).get("name") in {"recall", "read", "timeline", "ask"}
        )
    except (ValueError, AttributeError, TypeError):
        safe = False
    if not safe:
        attempts = 1
    status, body = post_once(endpoint, raw_line, token, timeout)
    if status != -1:
        return status, body
    for i in range(1, max(1, attempts)):
        time.sleep(RETRY_BACKOFF * i)
        status, body = post_once(endpoint, raw_line, token, timeout)
        if status != -1:
            return status, body
    return status, body


def handle_line(line, endpoint, token, timeout):
    """Forward one JSON-RPC line. Returns the token to use for the NEXT line.

    Returning the token is how a rotation heals for the rest of the session: the
    refreshed value is threaded back into main()'s loop, so only the ONE call
    that straddled the rotation pays a retry instead of every call thereafter.
    """
    parsed = None
    try:
        parsed = json.loads(line)
    except Exception:
        sys.stderr.write("invalid JSON\n")
        return token

    msg_id = parsed.get("id") if isinstance(parsed, dict) else None
    status, body = post_raw(endpoint, line, token, timeout)

    # A 401 mid-session almost always means the token ROTATED under us. A
    # secrets manager re-materialises /run/secrets/env.d/*.env and revokes the old
    # value, but this process resolved its token once at startup and would hand
    # the dead one to every later call -- an agent session that outlives a
    # rotation goes permanently memory-less with no signal beyond an opaque 401.
    # Re-read the file and retry once when the value has actually changed.
    if status == 401:
        fresh = token_from_env_file()
        if fresh and fresh != token:
            sys.stderr.write("memd-mcp-bridge: token rotated, retrying with the new value\n")
            token = fresh
            status, body = post_raw(endpoint, line, token, timeout)

    # Notifications never receive a response, even from a malformed upstream.
    if msg_id is None:
        return token

    if status == 200 and body:
        try:
            response = response_message(body, msg_id)
        except (ValueError, TypeError, UnicodeError):
            body = b"invalid JSON-RPC response from server"
        else:
            sys.stdout.write(json.dumps(response) + "\n")
            sys.stdout.flush()
            return token

    # Anything else is a *request* that failed. Never stay silent here: the client
    # blocks until the id it sent comes back, so a swallowed 401/429/500 reads as
    # an indefinite hang with nothing logged anywhere.
    reason = "HTTP {}".format(status) if status != -1 else "network error"
    if status == -1 and isinstance(parsed, dict) and parsed.get("method") == "tools/call" \
            and parsed.get("params", {}).get("name") == "save":
        reason += "; save outcome unknown: check recall/read before retrying"
    detail = body.decode("utf-8", errors="replace").strip()[:200]
    if detail:
        reason = "{}: {}".format(reason, detail)
    sys.stdout.write(synthesize_error(msg_id, reason) + "\n")
    sys.stdout.flush()
    sys.stderr.write(reason + "\n")
    return token


def main():
    argv = sys.argv
    if len(argv) > 1 and argv[1] == "--selftest":
        endpoint = resolve_endpoint(argv)
        token, source = resolve_token()
        return selftest(endpoint, token, source)

    endpoint = resolve_endpoint(argv)
    token, source = resolve_token()
    timeout = resolve_timeout()
    if not token:
        # stderr only: stdout is the JSON-RPC channel and must stay clean.
        sys.stderr.write("memd-mcp-bridge: no token ({}); every call will 401\n".format(source))

    try:
        for raw in sys.stdin:
            line = raw.strip()
            if not line:
                continue
            token = handle_line(line, endpoint, token, timeout)
    except (EOFError, KeyboardInterrupt):
        pass


if __name__ == "__main__":
    raise SystemExit(main())
